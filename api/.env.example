# Copie este archivo como ".env" y complete con los datos reales del servidor
DB_HOST=localhost
DB_PORT=3306
DB_USER=iniciativas_app
DB_PASSWORD=cambie_esta_clave
DB_NAME=iniciativas_legislativas

PORT=3000

# Genere una cadena aleatoria larga y única para este servidor:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Si cambia, se cierran todas las sesiones abiertas.
SESSION_SECRET=

# En producción: obliga a que la cookie de sesión solo viaje por HTTPS
NODE_ENV=production

# Origen permitido para el navegador (la URL desde la que se abre el tablero)
ORIGEN_PERMITIDO=https://mininterior.taildcdd19.ts.net

# Solo para instalaciones manuales sin Nginx delante: carpeta con el build
# de la web. Con Docker se deja vacío, porque los estáticos los sirve Nginx.
RUTA_ESTATICOS=

# --- Recuperación de contraseña --------------------------------------
# La API todavía no envía correo, así que el enlace de recuperación solo
# se escribe en el registro del servidor (consola de la API).
#
# DÉJELO SIN DEFINIR EN PRODUCCIÓN. Ponerlo en 1 devuelve el enlace en la
# respuesta HTTP, y entonces cualquiera puede pedir el de un correo ajeno
# y recibirlo en su propia pantalla: es una toma de cuenta. Solo para
# trabajar en local.
# RECUPERACION_ENLACE_EN_RESPUESTA=1
