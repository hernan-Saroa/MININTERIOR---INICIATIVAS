# Copie este archivo como ".env" y complete los valores.
# El .env no se versiona: está en .gitignore.

# --- Base de datos ---------------------------------------------------
MYSQL_ROOT_PASSWORD=
DB_NAME=iniciativas_legislativas
DB_USER=iniciativas_app
DB_PASSWORD=

# --- Sesiones --------------------------------------------------------
# Genere una cadena única para ESTE servidor:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Si cambia, se cierran todas las sesiones abiertas.
SESSION_SECRET=

# --- Recuperación de contraseña --------------------------------------
# La variable RECUPERACION_ENLACE_EN_RESPUESTA se configura en
# api/.env, no aquí: la API carga su propio archivo con dotenv desde
# api/, así que lo que se ponga en este no lo lee nadie. Ver
# api/.env.example.

# --- Red -------------------------------------------------------------
# URL desde la que se abre la aplicación en el navegador.
ORIGEN_PERMITIDO=https://mininterior.taildcdd19.ts.net

# Puerto del host que publica Nginx. Detrás de Tailscale o de un proxy,
# conviene dejarlo en 127.0.0.1 y no exponerlo directamente.
PUERTO_PUBLICO=8080
