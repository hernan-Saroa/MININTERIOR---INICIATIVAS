# Copie este archivo como ".env" y complete los valores.
# El .env no se versiona: está en .gitignore.
#
# `docker compose up` desde la raíz incluye infra-iniciativas/docker-compose.yml,
# así que estas variables son las que esa orquestación consume.

# --- Base de datos (única, compartida por los 6 microservicios) ------
DB_ROOT_PASSWORD=
DB_USER=iniciativas_app
DB_PASSWORD=

# --- Sesiones --------------------------------------------------------
# El MISMO valor lo usan los seis microservicios: es lo que permite que la
# cookie firmada en uno la validen los demás. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# --- Token de servicio (envío de correo) -----------------------------
# Solo quien lo envíe en la cabecera x-servicio-token puede pedir a
# ms-notificaciones que envíe correo. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SERVICIO_TOKEN=

# --- Red -------------------------------------------------------------
# Origen(es) permitido(s) para CORS, separados por comas.
ORIGEN_PERMITIDO=https://iniciativas.mininterior.gov.co

# --- Puertos públicos ------------------------------------------------
PUERTO_TABLERO=8080
PUERTO_RADICACION=8081
PUERTO_ADMIN=8082
